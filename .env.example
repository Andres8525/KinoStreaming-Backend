# Copy this file to .env and adjust the values for your local environment.
# Never commit real secrets.

PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/kino
DB_USERNAME=kino
DB_PASSWORD=kino_dev_password
DDL_AUTO=update

# Must be at least 32 bytes long.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200
