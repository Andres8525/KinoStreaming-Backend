# Copy this file to backend/.env and fill in your values. The backend loads it automatically.
# .env is ignored by git: never commit real passwords or secrets.
# Write values WITHOUT quotes.

PORT=8081

# --- Database: Supabase (recommended) ---------------------------------------
# Supabase > Project > Connect > "Session pooler" (works on IPv4 networks).
# Host format: aws-0-<region>.pooler.supabase.com or aws-1-<region>... (copy it exactly)   Port: 5432
# The username includes the project ref: postgres.<project-ref>
DB_URL=jdbc:postgresql://aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-supabase-database-password>
# Tables are created with src/main/resources/db/supabase/schema.sql, so Hibernate only validates them.
DDL_AUTO=validate
DB_POOL_SIZE=5

# --- Database: local Docker PostgreSQL (alternative) ------------------------
# DB_URL=jdbc:postgresql://localhost:5432/kino
# DB_USERNAME=kino
# DB_PASSWORD=kino_dev_password
# DDL_AUTO=update

# --- Security ---------------------------------------------------------------
# Must be at least 32 bytes long. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# Comma-separated list of origins allowed to call the API (Angular dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:4200
