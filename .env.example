# Copy this file to backend/.env and fill in your values. The backend loads it automatically.
# .env is ignored by git: never commit real passwords or secrets.
# Write values WITHOUT quotes.

PORT=8081

# --- Database: Supabase (recommended) ---------------------------------------
# Supabase > Project > Connect > "Session pooler" (works on IPv4 networks).
# Host format: aws-0-<region>.pooler.supabase.com or aws-1-<region>... (copy it exactly)   Port: 5432
# The username includes the project ref: postgres.<project-ref>
DB_URL=jdbc:postgresql://aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-supabase-database-password>
# Tables are created with src/main/resources/db/supabase/schema.sql, so Hibernate only validates them.
DDL_AUTO=validate
DB_POOL_SIZE=5

# --- Database: local Docker PostgreSQL (alternative) ------------------------
# DB_URL=jdbc:postgresql://localhost:5432/kino
# DB_USERNAME=kino
# DB_PASSWORD=kino_dev_password
# DDL_AUTO=update

# --- Security ---------------------------------------------------------------
# Must be at least 32 bytes long. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# Origins allowed to call the API (Angular dev server by default). Separate them with commas.
# Trailing slashes, quotes and spaces are ignored; use * for patterns, e.g. https://kino-*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Also allow https://<project>-*.vercel.app for each https://<project>.vercel.app above (Vercel deployment URLs).
CORS_ALLOW_VERCEL_PREVIEWS=true
# Allow the Angular dev server on any localhost port.
CORS_ALLOW_LOCALHOST=true

# --- Kino IA (trending analyzer) ---------------------------------------------
# Google Gemini is built in: set AI_ENABLED=true, AI_PROVIDER=gemini and AI_API_KEY (Google AI Studio key).
# With AI_ENABLED=false (or no key) Kino writes the summary from its own statistics. Never commit the key.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: defaults to gemini-2.5-flash.
AI_MODEL=gemini-2.5-flash
# Optional: defaults to https://generativelanguage.googleapis.com/v1beta
AI_BASE_URL=
# How long an analysis is reused (ISO-8601 duration). Limits calls to a paid AI provider.
AI_CACHE_TTL=PT5M
